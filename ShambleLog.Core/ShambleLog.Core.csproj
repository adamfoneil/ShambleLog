<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>ShambleLog.Core</PackageId>
    <Title>ShambleLog.Core</Title>
    <Version>0.9.9-alpha</Version>
    <Authors>Adam O'Neil</Authors>
    <Company>Adam O'Neil</Company>
    <Copyright>Copyright (c) 2026 Adam O'Neil</Copyright>
    <PackageProjectUrl>https://github.com/adamfoneil/ShambleLog</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/adamfoneil/ShambleLog</RepositoryUrl>
    <PackageTags>logging</PackageTags>
    <Description>Base classes and abstractions for a modern .NET logger provider</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShambleLog.Core.Tests" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
  </ItemGroup>

</Project>
