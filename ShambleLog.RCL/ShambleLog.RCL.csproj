<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>ShambleLog.RCL</PackageId>
    <Title>ShambleLog Razor Class Library</Title>
    <Version>1.0.2</Version>
    <Company>Adam O'Neil</Company>
    <Copyright>Copyright (c) 2026 Adam O'Neil</Copyright>
    <PackageProjectUrl>https://github.com/adamfoneil/ShambleLog</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/adamfoneil/ShambleLog</RepositoryUrl>
    <PackageTags>razor-class-library; logging</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Adam O'Neil</Authors>
    <Description>A log viewer UI made with Radzen Components used with ShambleLog</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
    <PackageReference Include="Radzen.Blazor" Version="13.4.0" />
    <PackageReference Include="ShambleLog.Core" Version="1.0.2" />
  </ItemGroup>

</Project>
