
@using ShambleLog.Core.Entities
@using ShambleLog.Core.Queries
@using ShambleLog.RCL.Widgets
@implements IDisposable

<div class="log-viewer">
    <section class="me-2">
        <RadzenAccordion>
            <Items>
                <RadzenAccordionItem Text="Categories">
                    <Categories CategoryLevelQuery="CategoryLevelQuery" Queries="Queries" CategorySelected="SelectCategory" />
                </RadzenAccordionItem>
                <RadzenAccordionItem Text="EF Core" Visible="_efCoreEnabled">

                </RadzenAccordionItem>
            </Items>
        </RadzenAccordion>
    </section>

    <section class="ms-2">
        <div class="d-flex align-items-center justify-content-between">
            <FilterBar @bind-Criteria="_criteria" @bind-Criteria:after="Refresh" EFCoreCriteria="_efCoreCriteria" />
            <Pager @bind-Value="_page" Change="Refresh" />
        </div>
        @if (_filterError is not null)
        {
            <div class="text-danger" role="alert">@_filterError</div>
        }
        <LogEntries Data="_logEntries" />
    </section>
</div>

@code {
    private const int PageSize = 50;
    private int _page;

    private bool _efCoreEnabled = false;
    private LogQuery.Criteria _criteria = new();
    private LogQuery.EFCoreCriteria? _efCoreCriteria;
    private string? _filterError;
    private LogEntry[] _logEntries = [];
    private EFCoreSummaryQuery.Result[] _efCoreSummaries = [];
    private long _refreshVersion;
    private CancellationTokenSource? _refreshCancellation;

    [Parameter, EditorRequired] public ScopedQueryRunner Queries { get; set; } = default!;
    [Parameter, EditorRequired] public CategoryLevelQuery CategoryLevelQuery { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }

    private Task SelectCategory(string category)
    {
        _criteria.CategoryContains = category;
        _page = 0;
        return Refresh();
    }


    private async Task Refresh()
    {
        var version = ++_refreshVersion;
        var previous = _refreshCancellation;
        using var cancellation = new CancellationTokenSource();
        _refreshCancellation = cancellation;
        previous?.Cancel();
        var criteria = new LogQuery.Criteria
        {
            Date = _criteria.Date,
            TimeExpression = _criteria.TimeExpression,
            CategoryContains = _criteria.CategoryContains,
            Level = _criteria.Level,
            TemplateContains = _criteria.TemplateContains,
            MessageContains = _criteria.MessageContains,
            PropertiesContain = _criteria.PropertiesContain
        };
        var skip = PageSize * _page;
        try
        {
            var entries = await Queries.ExecuteAsync<LogQuery, LogEntry[]>(query => query.ExecuteAsync(criteria, skip, PageSize, cancellation.Token));
            if (version != _refreshVersion)
                return;
            _logEntries = entries;
            _filterError = null;
            var summaries = await Queries.ExecuteAsync<EFCoreSummaryQuery, EFCoreSummaryQuery.Result[]>(query => query.ExecuteAsync(cancellationToken: cancellation.Token));
            if (version == _refreshVersion)
                _efCoreSummaries = summaries;
        }
        catch (FormatException ex)
        {
            if (version == _refreshVersion)
                _filterError = ex.Message;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        finally
        {
            if (ReferenceEquals(_refreshCancellation, cancellation))
                _refreshCancellation = null;
        }
    }

    public void Dispose()
    {
        _refreshVersion++;
        _refreshCancellation?.Cancel();
    }
}