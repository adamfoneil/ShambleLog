
@using ShambleLog.Core.Entities
@using ShambleLog.Core.Queries

<div class="log-viewer">
    <section class="me-2">
        <RadzenAccordion>
            <Items>
                <RadzenAccordionItem Text="Categories" Selected="true">

                </RadzenAccordionItem>
                <RadzenAccordionItem Text="EF Core" Visible="_efCoreEnabled">

                </RadzenAccordionItem>
            </Items>
        </RadzenAccordion>
    </section>

    <section class="ms-2">
        <FilterBar @bind-Criteria="_criteria" @bind-Criteria:after="Refresh" EFCoreCriteria="_efCoreCriteria" />
        @*main table*@
    </section>
</div>

@code {
    private bool _efCoreEnabled = false;
    private LogQuery.Criteria _criteria = new();
    private LogQuery.EFCoreCriteria? _efCoreCriteria;
    private LogEntry[] _logEntries = [];
    private CategorySummaryQuery.Result[] _categorySummaries = [];
    private EFCoreSummaryQuery.Result[] _efCoreSummaries = [];

    [Parameter, EditorRequired] public LogQuery LogQuery { get; set; }
    [Parameter, EditorRequired] public CategorySummaryQuery CategorySummaryQuery { get; set; }
    [Parameter, EditorRequired] public EFCoreSummaryQuery EFCoreSummaryQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }


    private async Task Refresh()
    {
        _categorySummaries = await CategorySummaryQuery.ExecuteAsync();
        _logEntries = await LogQuery.ExecuteAsync(_criteria);
        _efCoreSummaries = await EFCoreSummaryQuery.ExecuteAsync();
    }
}