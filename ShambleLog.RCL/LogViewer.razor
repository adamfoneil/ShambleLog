
@using ShambleLog.Core.Entities
@using ShambleLog.Core.Queries
@using ShambleLog.RCL.Widgets
@implements IDisposable

<div class="log-viewer">
    <section class="me-2">
        <RadzenAccordion>
            <Items>
                <RadzenAccordionItem Text="Categories">
                    <Categories CategoryLevelQuery="CategoryLevelQuery" Queries="Queries" Date="_criteria.Date" TimeExpression="@_criteria.TimeExpression" CategorySelected="SelectCategory" CategoryLevelSelected="SelectCategoryLevel" />
                </RadzenAccordionItem>
                <RadzenAccordionItem Text="EF Core" Visible="EFCoreEnabled">
                    @if (EFCoreEnabled)
                    {
                        <EFCore Queries="Queries" Date="_criteria.Date" TimeExpression="@_criteria.TimeExpression" MetricSelected="SelectEFCoreMetric" />
                    }
                </RadzenAccordionItem>
            </Items>
        </RadzenAccordion>
    </section>

    <section class="ms-2">
        <div class="d-flex align-items-start justify-content-between">
            <FilterBar @bind-Criteria="_criteria" @bind-Criteria:after="FiltersChanged" @bind-EFCoreCriteria="_efCoreCriteria" @bind-EFCoreCriteria:after="FiltersChanged" />
            <Pager @bind-Value="_page" Change="Refresh" />
        </div>
        @if (_filterError is not null)
        {
            <div class="text-danger" role="alert">@_filterError</div>
        }
        <LogEntries Data="_logEntries" HasDateFilter="_appliedDate.HasValue" />
    </section>
</div>

@code {
    private const int PageSize = 50;
    private int _page;

    private LogQuery.Criteria _criteria = new();
    private LogQuery.EFCoreCriteria? _efCoreCriteria;
    private string? _filterError;
    private LogEntry[] _logEntries = [];
    private DateOnly? _appliedDate;
    private long _refreshVersion;
    private CancellationTokenSource? _refreshCancellation;

    [Parameter, EditorRequired] public ScopedQueryRunner Queries { get; set; } = default!;
    [Parameter, EditorRequired] public CategoryLevelQuery CategoryLevelQuery { get; set; } = default!;
    [Parameter] public bool EFCoreEnabled { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }

    private Task SelectCategory(string category)
    {
        _criteria.CategoryContains = category;
        _page = 0;
        return Refresh();
    }

    private Task SelectCategoryLevel((string Category, Microsoft.Extensions.Logging.LogLevel Level) selection)
    {
        _criteria.Level = selection.Level;
        return SelectCategory(selection.Category);
    }

    private Task SelectEFCoreMetric(EFCoreMetricsQuery.Result selection)
    {
        _efCoreCriteria ??= new();
        switch (selection.Type)
        {
            case EFCoreMetricsQueryType.Tag:
                _efCoreCriteria.Tag = selection.Name;
                break;
            case EFCoreMetricsQueryType.Table:
                _efCoreCriteria.Table = selection.Name;
                break;
            default:
                throw new ArgumentOutOfRangeException(nameof(selection), selection.Type, "Unknown EF Core metric type.");
        }
        return FiltersChanged();
    }

    private Task FiltersChanged()
    {
        _page = 0;
        return Refresh();
    }

    private async Task Refresh()
    {
        var version = ++_refreshVersion;
        var previous = _refreshCancellation;
        using var cancellation = new CancellationTokenSource();
        _refreshCancellation = cancellation;
        previous?.Cancel();
        var criteria = new LogQuery.Criteria
        {
            Date = _criteria.Date,
            TimeExpression = _criteria.TimeExpression,
            CategoryContains = _criteria.CategoryContains,
            Level = _criteria.Level,
            TemplateContains = _criteria.TemplateContains,
            MessageContains = _criteria.MessageContains,
            PropertiesContain = _criteria.PropertiesContain
        };
        var efCoreCriteria = _efCoreCriteria is { } efCriteria ? new LogQuery.EFCoreCriteria
        {
            Table = efCriteria.Table,
            Tag = efCriteria.Tag,
            CommandTextContains = efCriteria.CommandTextContains,
            MinElapsedMs = efCriteria.MinElapsedMs
        } : null;
        var skip = PageSize * _page;
        try
        {
            var entries = await Queries.ExecuteAsync<LogQuery, LogEntry[]>(async query =>
            {
                if (efCoreCriteria is null)
                    return await query.ExecuteAsync(criteria, skip, PageSize, cancellation.Token);

                var commands = await query.ExecuteAsync(efCoreCriteria, skip, PageSize, criteria, cancellation.Token);
                return commands.Select(command =>
                {
                    command.LogEntry.EFCoreEntry = command;
                    return command.LogEntry;
                }).ToArray();
            });
            if (version != _refreshVersion)
                return;
            _logEntries = entries;
            _appliedDate = criteria.Date;
            _filterError = null;
        }
        catch (FormatException ex)
        {
            if (version == _refreshVersion)
                _filterError = ex.Message;
        }
        catch (NotSupportedException ex) when (efCoreCriteria is not null)
        {
            if (version == _refreshVersion)
                _filterError = ex.Message;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        finally
        {
            if (ReferenceEquals(_refreshCancellation, cancellation))
                _refreshCancellation = null;
        }
    }

    public void Dispose()
    {
        _refreshVersion++;
        _refreshCancellation?.Cancel();
    }
}