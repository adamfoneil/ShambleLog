@typeparam TDbContext where TDbContext : DbContext, ILoggingDbContext

@using Microsoft.EntityFrameworkCore
@using ShambleLog.Core
@using ShambleLog.Core.Middleware

<div class="log-viewer">
    <div>
        <RadzenAccordion>
            <Items>
                <RadzenAccordionItem Text="Categories">

                </RadzenAccordionItem>
                <RadzenAccordionItem Text="EF Core" Visible="_efCoreEnabled">

                </RadzenAccordionItem>
            </Items>
        </RadzenAccordion>
    </div>

    <div>
        @*filter bar*@
        @*main table*@
    </div>
</div>

@code {
    private bool _efCoreEnabled = false;

    [Parameter, EditorRequired] public IDbContextFactory<TDbContext> DbFactory { get; set; }

    protected override void OnParametersSet()
    {
        _efCoreEnabled = typeof(IEFCoreLoggingDbContext).IsAssignableFrom(typeof(TDbContext));
    }
}