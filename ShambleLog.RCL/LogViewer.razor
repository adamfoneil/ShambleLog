
@using ShambleLog.Core.Entities
@using ShambleLog.Core.Queries
@using ShambleLog.RCL.Widgets

<div class="log-viewer">
    <section class="me-2">
        <RadzenAccordion>
            <Items>
                <RadzenAccordionItem Text="Categories" Selected="true">
                    <Categories CategoryLevelQuery="CategoryLevelQuery" CategorySummaryQuery="CategorySummaryQuery" />
                </RadzenAccordionItem>
                <RadzenAccordionItem Text="EF Core" Visible="_efCoreEnabled">

                </RadzenAccordionItem>
            </Items>
        </RadzenAccordion>
    </section>

    <section class="ms-2">
        <div class="d-flex align-items-center justify-content-between">
            <FilterBar @bind-Criteria="_criteria" @bind-Criteria:after="Refresh" EFCoreCriteria="_efCoreCriteria" />
            <Pager @bind-Value="_page" Change="Refresh" />
        </div>
        @if (_filterError is not null)
        {
            <div class="text-danger" role="alert">@_filterError</div>
        }
        <LogEntries Data="_logEntries" />
    </section>
</div>

@code {
    private const int PageSize = 50;
    private int _page;

    private bool _efCoreEnabled = false;
    private LogQuery.Criteria _criteria = new();
    private LogQuery.EFCoreCriteria? _efCoreCriteria;
    private string? _filterError;
    private LogEntry[] _logEntries = [];
    private EFCoreSummaryQuery.Result[] _efCoreSummaries = [];

    [Parameter, EditorRequired] public LogQuery LogQuery { get; set; }
    [Parameter, EditorRequired] public CategorySummaryQuery CategorySummaryQuery { get; set; }
    [Parameter, EditorRequired] public CategoryLevelQuery CategoryLevelQuery { get; set; }
    [Parameter, EditorRequired] public EFCoreSummaryQuery EFCoreSummaryQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }


    private async Task Refresh()
    {
        try
        {
            _logEntries = await LogQuery.ExecuteAsync(_criteria, PageSize * _page, PageSize);
            _filterError = null;
        }
        catch (FormatException ex)
        {
            _filterError = ex.Message;
            return;
        }
        _efCoreSummaries = await EFCoreSummaryQuery.ExecuteAsync();
    }
}