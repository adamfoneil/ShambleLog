@using Microsoft.Extensions.Logging
@using Microsoft.EntityFrameworkCore
@using ShambleLog.Core.Entities
@using ShambleLog.Core.Queries

@{
    var groups = CategorySummaryProjection.Build(_rules, _summaries);
    RenderFragment editor = @<div class="d-flex flex-wrap align-items-end gap-2">
        <label>Category
            <input class="form-control form-control-sm" @bind="_editing!.Category" disabled="@(IsDefault(_originalCategory) || _busy)" />
        </label>
        <label>Level
            <select class="form-select form-select-sm" @bind="_editing!.Level" disabled="@_busy">
                @foreach (var level in Enum.GetValues<LogLevel>())
                {
                    <option value="@level">@level</option>
                }
            </select>
        </label>
        <button type="button" class="btn btn-sm btn-primary" @onclick="Save" disabled="@_busy">Save</button>
        <button type="button" class="btn btn-sm btn-secondary" @onclick="Cancel" disabled="@_busy">Cancel</button>
        @if (_error is not null)
        {
            <div class="text-danger" role="alert">@_error</div>
        }
    </div>;
}

<div class="d-flex gap-2 mb-2">
    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Refresh" disabled="@_busy">Refresh</button>
</div>
@if (_error is not null && _editing is null)
{
    <div class="text-danger" role="alert">@_error</div>
}
@foreach (var group in groups)
{
    var rule = group.CategoryLevel;
    <div class="border-bottom py-2" @key="rule.Category">
        @if (_editing is not null && _originalCategory == rule.Category)
        {
            @editor
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center gap-2">
                <div class="text-break">
                    <strong>@rule.Category</strong>
                    <span class="badge @CssUtil.GetLogLevelBadgeClass(rule.Level)">@rule.Level</span>
                    @if (rule.IsTemporary)
                    {
                        <span class="badge bg-secondary">Temporary</span>
                    }
                </div>
                <div class="d-flex flex-shrink-0 gap-2">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(() => Edit(rule))" Disabled="@_busy" aria-label="@($"Edit {rule.Category}")" title="@($"Edit {rule.Category}")" />
                    @if (!IsDefault(rule.Category))
                    {
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => Delete(rule))" Disabled="@_busy" aria-label="@($"Delete {rule.Category}")" title="@($"Delete {rule.Category}")" />
                    }
                </div>
            </div>
        }
        @foreach (var projectedSummary in group.Summaries)
        {
            var summary = projectedSummary.Result;
            <div class="ms-4 mt-1 d-flex justify-content-between align-items-center gap-2" @key="summary.Category" @onclick="() => CategorySelected.InvokeAsync(summary.Category)">
              <div>
                <button type="button" class="btn btn-link btn-sm p-0" aria-label="Filter logs by @summary.Category" title="@summary.Category">@projectedSummary.DisplayCategory</button>
                @foreach (var level in projectedSummary.LiveLevelOptions)
                {
                    var action = level < rule.Level ? "Increase" : "Decrease";
                    var buttonTitle = $"{action} to {level}";
                    var buttonLabel = level == LogLevel.Information ? "Info" : level.ToString();
                    var ariaLabel = $"{action} {summary.Category} to {level}";
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SetLevel(summary, level)" @onclick:stopPropagation="true" disabled="@_busy" aria-label="@ariaLabel" title="@buttonTitle">@buttonLabel</button>
                }
              </div>
              <div class="text-nowrap">
                @foreach (var count in summary.LevelCounts.OrderBy(item => item.Key))
                {
                    <button type="button" class="btn p-0 border-0" @onclick="() => CategoryLevelSelected.InvokeAsync((summary.Category, count.Key))" @onclick:stopPropagation="true" aria-label="Filter logs by @summary.Category and @count.Key level">
                        <span class="badge @CssUtil.GetLogLevelBadgeClass(count.Key) me-2" title="@count.Key">@count.Value</span>
                    </button>
                }
              </div>
            </div>
        }
    </div>
}
<div class="py-2">
    @if (_editing is not null && (_originalCategory is null || !groups.Any(group => group.CategoryLevel.Category == _originalCategory)))
    {
        @editor
    }
    else
    {
        <button type="button" class="btn btn-sm btn-primary" @onclick="NewRule" disabled="@_busy">Add category</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public CategoryLevelQuery CategoryLevelQuery { get; set; } = default!;
    [Parameter, EditorRequired] public ScopedQueryRunner Queries { get; set; } = default!;
    [Parameter] public EventCallback<string> CategorySelected { get; set; }
    [Parameter] public EventCallback<(string Category, LogLevel Level)> CategoryLevelSelected { get; set; }
    [Parameter] public DateOnly? Date { get; set; }
    [Parameter] public string? TimeExpression { get; set; }

    private CategoryLevel[] _rules = [];
    private CategorySummaryQuery.Result[] _summaries = [];
    private CategoryLevel? _editing;
    private string? _originalCategory;
    private string? _error;
    private bool _busy;
    private bool _refreshPending;
    private bool _initialized;
    private DateOnly? _lastDate;
    private string? _lastTimeExpression;

    protected override Task OnParametersSetAsync()
    {
        if (_initialized && Date == _lastDate && TimeExpression == _lastTimeExpression)
            return Task.CompletedTask;

        _initialized = true;
        _lastDate = Date;
        _lastTimeExpression = TimeExpression;
        return Refresh();
    }

    public Task Refresh()
    {
        if (_busy)
        {
            _refreshPending = true;
            return Task.CompletedTask;
        }
        return Run(RefreshCore);
    }

    private async Task RefreshCore()
    {
        var date = Date;
        var timeExpression = TimeExpression;
        var rules = await CategoryLevelQuery.ExecuteAsync();
        var summaries = await Queries.ExecuteAsync<CategorySummaryQuery, CategorySummaryQuery.Result[]>(query => query.ExecuteAsync(date, timeExpression));
        if (date == Date && timeExpression == TimeExpression)
        {
            _rules = rules;
            _summaries = summaries;
        }
    }

    private static bool IsDefault(string? category) => string.Equals(category, "Default", StringComparison.OrdinalIgnoreCase);

    private void NewRule()
    {
        _error = null;
        _originalCategory = null;
        _editing = new CategoryLevel { Level = LogLevel.Information };
    }

    private void Edit(CategoryLevel rule)
    {
        _error = null;
        _originalCategory = rule.Category;
        _editing = new CategoryLevel { Category = rule.Category, Level = rule.Level, IsTemporary = rule.IsTemporary };
    }

    private void Cancel() { _editing = null; _error = null; }

    private Task Save() => Run(async () =>
    {
        await CategoryLevelQuery.SaveAsync(_editing!, _originalCategory);
        Cancel();
        await RefreshCore();
    });

    private Task Delete(CategoryLevel rule) => Run(async () =>
    {
        await CategoryLevelQuery.DeleteAsync(rule.Category);
        Cancel();
        await RefreshCore();
    });

    private Task SetLevel(CategorySummaryQuery.Result summary, LogLevel level) => Run(async () =>
    {
        await CategoryLevelQuery.SetCategoryLevelAsync(summary.Category, level);
        await RefreshCore();
    });

    private async Task Run(Func<Task> action)
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (FormatException ex) { _error = ex.Message; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        catch (DbUpdateException) { _error = "Unable to save the category level. Refresh and try again."; }
        finally
        {
            _busy = false;
            if (_refreshPending)
            {
                _refreshPending = false;
                await Refresh();
            }
        }
    }
}
