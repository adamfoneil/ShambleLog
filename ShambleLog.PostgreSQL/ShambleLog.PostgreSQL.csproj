<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>ShambleLog</PackageId>
    <Title>ShambleLog</Title>
    <Version>0.9.0-alpha</Version>
    <Authors>Adam O'Neil</Authors>
    <Company>Adam O'Neil</Company>
    <Description>An EF Core-based logger targeting Postgres, ILogger&lt;T&gt; compatible</Description>
    <Copyright>Copyright (c) 2026 Adam O'Neil</Copyright>
    <PackageProjectUrl>https://github.com/adamfoneil/ShambleLog</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/adamfoneil/ShambleLog</RepositoryUrl>
    <PackageTags>logging; efcore; postgres</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ShambleLog.Core\Entities\CategoryLevel.cs" Link="Core\Entities\CategoryLevel.cs" />
    <Compile Include="..\ShambleLog.Core\Entities\EFCoreEntry.cs" Link="Core\Entities\EFCoreEntry.cs" />
    <Compile Include="..\ShambleLog.Core\Entities\LogEntry.cs" Link="Core\Entities\LogEntry.cs" />
    <Compile Include="..\ShambleLog.Core\CategoryLevelInitializer.cs" Link="Core\CategoryLevelInitializer.cs" />
    <Compile Include="..\ShambleLog.Core\ILoggingDbContext.cs" Link="Core\ILoggingDbContext.cs" />
    <Compile Include="..\ShambleLog.Core\LogEntryQueue.cs" Link="Core\LogEntryQueue.cs" />
    <Compile Include="..\ShambleLog.Core\LogEntryPipeline.cs" Link="Core\LogEntryPipeline.cs" />
    <Compile Include="..\ShambleLog.Core\LogEntryWriter.cs" Link="Core\LogEntryWriter.cs" />
    <Compile Include="..\ShambleLog.Core\SuppressedCategoryTracker.cs" Link="Core\SuppressedCategoryTracker.cs" />
    <Compile Include="..\ShambleLog.Core\RetentionPeriodService.cs" Link="Core\RetentionPeriodService.cs" />
    <Compile Include="..\ShambleLog.Core\IdentityUserEnricher.cs" Link="Core\IdentityUserEnricher.cs" />
    <Compile Include="..\ShambleLog.Core\RequestLoggingStartupFilter.cs" Link="Core\RequestLoggingStartupFilter.cs" />
    <Compile Include="..\ShambleLog.Core\ShambleLogLoggerProvider.cs" Link="Core\ShambleLogLoggerProvider.cs" />
    <Compile Include="..\ShambleLog.Core\LoggingBuilderExtensions.cs" Link="Core\LoggingBuilderExtensions.cs" />
    <Compile Include="..\ShambleLog.Core\Registration.cs" Link="Core\Registration.cs" />
    <Compile Include="..\ShambleLog.Core\Middleware\EFCoreMiddleware.cs" Link="Core\Middleware\EFCoreMiddleware.cs" />
    <Compile Include="..\ShambleLog.Core\Middleware\EFCoreMiddlewareExtensions.cs" Link="Core\Middleware\EFCoreMiddlewareExtensions.cs" />
    <Compile Include="..\ShambleLog.Core\Middleware\IEFCoreLoggingDbContext.cs" Link="Core\Middleware\IEFCoreLoggingDbContext.cs" />
    <Compile Include="..\ShambleLog.Core\Queries\LogQuery.cs" Link="Core\Queries\LogQuery.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Core\Entities\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
  </ItemGroup>

</Project>
