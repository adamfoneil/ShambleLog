<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>ShambleLog.PostgreSQL</PackageId>
    <Title>ShambleLog.PostgreSQL</Title>
    <Version>0.9.2-alpha</Version>
    <Authors>Adam O'Neil</Authors>
    <Company>Adam O'Neil</Company>
    <Description>An EF Core-based logger targeting Postgres, ILogger&lt;T&gt; compatible</Description>
    <Copyright>Copyright (c) 2026 Adam O'Neil</Copyright>
    <PackageProjectUrl>https://github.com/adamfoneil/ShambleLog</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/adamfoneil/ShambleLog</RepositoryUrl>
    <PackageTags>logging; efcore; postgres</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
    <PackageReference Include="ShambleLog.Core" Version="0.9.7-alpha" />
  </ItemGroup>

</Project>
